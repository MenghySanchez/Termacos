#!/bin/bash
set -u

LOG_FILE="/Library/Logs/TermacosSSH-install.log"

log() {
    /bin/echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] $*" >> "${LOG_FILE}"
}

find_puttygen() {
    for candidate in "/opt/homebrew/bin/puttygen" "/usr/local/bin/puttygen" "/usr/bin/puttygen"; do
        if [ -x "${candidate}" ]; then
            /bin/echo "${candidate}"
            return 0
        fi
    done
    return 1
}

find_brew() {
    for candidate in "/opt/homebrew/bin/brew" "/usr/local/bin/brew"; do
        if [ -x "${candidate}" ]; then
            /bin/echo "${candidate}"
            return 0
        fi
    done
    return 1
}

log "Termacos SSH postinstall started."

if find_puttygen >/dev/null; then
    log "puttygen already installed."
    exit 0
fi

BREW_PATH="$(find_brew || true)"
if [ -z "${BREW_PATH}" ]; then
    log "Homebrew not found. Skipping automatic putty installation. Install manually with: brew install putty"
    exit 0
fi

CONSOLE_USER="$(/usr/bin/stat -f %Su /dev/console)"
if [ -z "${CONSOLE_USER}" ] || [ "${CONSOLE_USER}" = "root" ] || [ "${CONSOLE_USER}" = "loginwindow" ]; then
    log "No valid console user found. Skipping automatic putty installation."
    exit 0
fi

log "Installing putty with Homebrew for user ${CONSOLE_USER}."
/usr/bin/sudo -H -u "${CONSOLE_USER}" env HOMEBREW_NO_AUTO_UPDATE=1 "${BREW_PATH}" list putty >/dev/null 2>&1
if [ $? -eq 0 ]; then
    log "putty already installed through Homebrew."
    exit 0
fi

/usr/bin/sudo -H -u "${CONSOLE_USER}" env HOMEBREW_NO_AUTO_UPDATE=1 "${BREW_PATH}" install putty >> "${LOG_FILE}" 2>&1
if [ $? -eq 0 ]; then
    log "putty installed successfully."
else
    log "putty installation failed. User can install manually with: brew install putty"
fi

exit 0
